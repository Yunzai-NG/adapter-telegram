# 国内网络环境：沿用框架仓库已验证的镜像配置
registry=https://registry.npmmirror.com

# 框架包（@yunzai-ng/core、@yunzai-ng/types）声明为 peerDependencies：运行期由宿主
# 提供，插件目录内不应再装一份 —— 两份内核各持一套注册表，插件注册到哪一份取决于
# 解析顺序，结果无法预期。
#
# pnpm 9 缺省 auto-install-peers=true 会试图从 registry 安装它们：框架发布前使
# install 直接失败，发布后则装入上述第二份内核。因此必须关闭。
# 开发期的解析由 `pnpm run link:framework` 建立的链接满足。
auto-install-peers=false
